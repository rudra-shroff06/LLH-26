#!/usr/bin/env python3
"""kvalidate - check that KIR programs are valid, and (optionally) that an optimized
program behaves exactly like the original.

Usage:
  kvalidate FILE.kir [FILE2.kir ...] [--machine machine.cfg]
  kvalidate OPT.kir --against ORIG.kir [--input FILE.in]... [--random N] [--seed S]
                    [--max-steps S] [--machine machine.cfg]

With --against, the sample input next to the original (ORIG.in) is tested automatically.

A file that passes gets a stamp file (FILE.kir.ok); ksim only runs stamped files.
Exit codes: 0 = everything passed, 1 = a check failed, 2 = usage or file error.
"""
import argparse
import glob
import os
import signal
import sys

if hasattr(signal, 'SIGPIPE'):          # no traceback when the output is piped into head
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import kirlib as K  # noqa: E402


def expand_wildcards(names):
    """cmd.exe passes bench\\*.kir unchanged, so expand wildcards here (a no-op on Linux/macOS)."""
    out = []
    for name in names:
        if any(c in name for c in '*?[') and not os.path.exists(name):
            found = sorted(glob.glob(name))
            out.extend(found if found else [name])
        else:
            out.append(name)
    return out


def validate_one(path, mc):
    """Return (Program or None, error message or None). Updates the stamp state."""
    K.remove_stamp(path)
    if not os.path.exists(path):
        return None, "file not found"
    try:
        prog = K.load_program(path)
        if mc is not None:
            K.check_machine_features(prog, mc)
    except K.KirError as e:
        return None, str(e)
    return prog, None


def main():
    ap = argparse.ArgumentParser(prog='kvalidate', description='Validate KIR programs.')
    ap.add_argument('files', nargs='+')
    ap.add_argument('--against', default=None, metavar='ORIG.kir',
                    help='also check that FILE behaves exactly like ORIG on many inputs')
    ap.add_argument('--machine', default=None, help='also check that the machine has the fused ops used')
    ap.add_argument('--input', action='append', default=[], metavar='FILE.in',
                    help='extra input file to test with (can be repeated; only with --against)')
    ap.add_argument('--random', type=int, default=100, metavar='N',
                    help='number of generated inputs (default 100; only with --against)')
    ap.add_argument('--seed', type=int, default=12345, help='seed for generated inputs (default 12345)')
    ap.add_argument('--max-steps', type=int, default=200000,
                    help='step limit for the original program per input (default 200000)')
    opts = ap.parse_args()
    opts.files = expand_wildcards(opts.files)

    if opts.against is None and (opts.input or opts.random != 100):
        sys.stderr.write("ERROR: --input and --random can only be used together with --against\n")
        return 2
    if opts.against is not None and len(opts.files) != 1:
        sys.stderr.write("ERROR: --against needs exactly one file to check\n")
        return 2
    if opts.random < 0 or opts.max_steps < 1:
        sys.stderr.write("ERROR: --random must be >= 0 and --max-steps >= 1\n")
        return 2
    mc = None
    if opts.machine:
        try:
            mc = K.load_machine(opts.machine)
        except K.KirError as e:
            sys.stderr.write("ERROR: %s\n" % e)
            return 2

    failed = False
    progs = {}
    for path in opts.files:
        prog, err = validate_one(path, mc)
        if err:
            print("ERROR %s: %s" % (path, err))
            failed = True
        else:
            progs[path] = prog
            if opts.against is None:
                K.write_stamp(path)
                print("OK %s (function %s, %d instructions, %d blocks)" %
                      (path, prog.name, len(prog.instrs), len(prog.block_labels)))
    if opts.against is None:
        return 1 if failed else 0

    # ---- --against mode ----
    opt_path = opts.files[0]
    if failed:
        return 1
    orig, err = None, None
    try:
        if not os.path.exists(opts.against):
            raise K.KirError("file not found")
        orig = K.load_program(opts.against)
        if mc is not None:
            K.check_machine_features(orig, mc)
    except K.KirError as e:
        print("ERROR %s: %s" % (opts.against, e))
        return 1
    opt = progs[opt_path]
    if len(opt.params) != len(orig.params):
        print("ERROR %s: takes %d parameter(s) but the original takes %d" %
              (opt_path, len(opt.params), len(orig.params)))
        return 1
    input_files = list(opts.input)
    guess = os.path.splitext(opts.against)[0] + '.in'
    if os.path.exists(guess) and guess not in input_files:
        input_files.insert(0, guess)       # the original's own sample input is always tested too
    try:
        inputs = [K.load_input(p, len(orig.params)) for p in input_files]
    except K.KirError as e:
        sys.stderr.write("ERROR: %s\n" % e)
        return 2
    inputs += K.generate_inputs(len(orig.params), opts.random, opts.seed)
    if not inputs:
        sys.stderr.write("ERROR: no inputs to test with\n")
        return 2
    cp_o, cp_n = K.compile_program(orig), K.compile_program(opt)
    tested = skipped = 0
    for n, inp in enumerate(inputs):
        ro = K.execute(cp_o, inp.args, inp.segments, inp.vin, opts.max_steps)
        if ro.status == 'TIMEOUT':
            skipped += 1
            continue
        rn = K.execute(cp_n, inp.args, inp.segments, inp.vin, 20 * ro.steps + 1000)
        tested += 1
        diff = K.first_difference(ro, rn)
        if diff:
            print("MISMATCH %s vs %s on input #%d: %s" % (opt_path, opts.against, n, diff))
            print("input that shows the problem (save it as a .in file to reproduce):")
            print(K.format_input(inp))
            return 1
    if tested == 0:
        print("ERROR: the original did not finish on any input (limit %d steps); nothing was compared" % opts.max_steps)
        return 1
    K.write_stamp(opt_path)
    print("OK %s behaves like %s on %d inputs (%d skipped because the original did not finish within %d steps)" %
          (opt_path, opts.against, tested, skipped, opts.max_steps))
    if input_files:
        print("Inputs used include: %s" % ', '.join(input_files))
    print("Note: passing here does not prove equivalence; the judges test many more inputs.")
    return 0


if __name__ == '__main__':
    sys.exit(main())
