; hand-written optimized version of bench/branchy_select.kir
func branchy_select(v0)
entry:
  and v0, v0, 63
  const v1, 0          ; s
  const v2, 0          ; i
  jmp head
head:
  lt v3, v2, v0
  br v3, body, done
body:
  load v4, v2          ; v = m[i]
  lt v5, 100, v4       ; v > 100 ?
  select v6, v5, v4, 100     ; x = v if v > 100 else 100  (no jump needed)
  and v7, v4, 1
  add v8, v6, 1
  sub v9, v6, 1
  select v10, v7, v8, v9     ; y = x + 1 if v is odd, else x - 1
  add v1, v1, v10
  add v2, v2, 1
  jmp head
done:
  ret v1
