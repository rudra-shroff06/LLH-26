; hand-written optimized version of bench/guarded_div.kir
func guarded_div(v0, v1)
entry:
  br v1, compute, nodiv      ; the division only happens when d is not 0, exactly as before
compute:
  div v2, v0, v1             ; computed ONCE, not 8 times, and still guarded
  mul v3, v2, 8              ; adding the same value 8 times is the same as multiplying by 8
  add v3, v3, 28             ; plus 0 + 1 + ... + 7 = 28
  ret v3
nodiv:
  ret 28
