; name: sensor_threshold
; category: effects
; description: reads a sensor (dropping every second reading) and logs only the large readings
; sample input: sensor_threshold.in

func sensor_threshold(v0)
entry:
  and v1, v0, 15
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  vload v6, 3
  mov v5, v6
  vload v8, 3
  mov v7, v8
  lt v9, 100, v5
  br v9, then4, else6
then4:
  vstore 4, v5
  jmp endif5
else6:
  add v10, v2, 1
  mov v2, v10
  jmp endif5
endif5:
  add v11, v3, 1
  mov v3, v11
  jmp for_head1
for_exit3:
  ret v2
