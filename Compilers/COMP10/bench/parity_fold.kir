; name: parity_fold
; category: bits
; description: parity of a word by xor folding (straight-line code)
; sample input: parity_fold.in

func parity_fold(v0)
entry:
  shr v1, v0, 16
  xor v2, v0, v1
  mov v0, v2
  shr v3, v0, 8
  xor v4, v0, v3
  mov v0, v4
  shr v5, v0, 4
  xor v6, v0, v5
  mov v0, v6
  shr v7, v0, 2
  xor v8, v0, v7
  mov v0, v8
  shr v9, v0, 1
  xor v10, v0, v9
  mov v0, v10
  and v11, v0, 1
  ret v11
