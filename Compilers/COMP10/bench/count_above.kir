; name: count_above
; category: arrays
; description: count the elements greater than a threshold
; sample input: count_above.in

func count_above(v0, v1)
entry:
  and v2, v0, 63
  mov v0, v2
  const v3, 0
  const v4, 0
  jmp for_head1
for_head1:
  lt v5, v4, v0
  br v5, for_body2, for_exit3
for_body2:
  load v6, v4
  lt v7, v1, v6
  br v7, then4, endif5
then4:
  add v8, v3, 1
  mov v3, v8
  jmp endif5
endif5:
  add v9, v4, 1
  mov v4, v9
  jmp for_head1
for_exit3:
  ret v3
