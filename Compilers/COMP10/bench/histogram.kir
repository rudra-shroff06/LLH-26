; name: histogram
; category: arrays
; description: histogram of low 3 bits into bins at 300..307
; sample input: histogram.in

func histogram(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, v0
  br v3, for_body2, for_exit3
for_body2:
  load v5, v2
  and v6, v5, 7
  mov v4, v6
  add v7, 300, v4
  load v8, v7
  add v9, v8, 1
  add v10, 300, v4
  store v10, v9
  add v11, v2, 1
  mov v2, v11
  jmp for_head1
for_exit3:
  ret v0
