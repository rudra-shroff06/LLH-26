; name: run_count
; category: state
; description: count runs of equal neighbouring values
; sample input: run_count.in

func run_count(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  eq v2, v0, 0
  br v2, then1, endif2
then1:
  ret 0
endif2:
  load v4, 0
  mov v3, v4
  const v5, 1
  const v6, 1
  jmp for_head3
for_head3:
  lt v7, v6, v0
  br v7, for_body4, for_exit5
for_body4:
  load v8, v6
  eq v10, v8, v3
  eq v9, v10, 0
  br v9, then6, endif7
then6:
  add v11, v5, 1
  mov v5, v11
  load v12, v6
  mov v3, v12
  jmp endif7
endif7:
  add v13, v6, 1
  mov v6, v13
  jmp for_head3
for_exit5:
  ret v5
