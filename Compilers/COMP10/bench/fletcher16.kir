; name: fletcher16
; category: bits
; description: Fletcher-16 checksum
; sample input: fletcher16.in

func fletcher16(v0)
entry:
  const v1, 63
  and v2, v0, v1
  mov v0, v2
  const v3, 0
  const v4, 0
  const v5, 0
  jmp for_head1
for_head1:
  lt v6, v5, v0
  br v6, for_body2, for_exit3
for_body2:
  load v7, v5
  const v8, 255
  and v9, v7, v8
  add v10, v3, v9
  const v11, 255
  mod v12, v10, v11
  mov v3, v12
  add v13, v4, v3
  const v14, 255
  mod v15, v13, v14
  mov v4, v15
  const v16, 1
  add v17, v5, v16
  mov v5, v17
  jmp for_head1
for_exit3:
  const v18, 8
  shl v19, v4, v18
  or v20, v19, v3
  ret v20
