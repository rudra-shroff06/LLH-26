; name: sieve
; category: numbers
; description: sieve of Eratosthenes using flags at 512..
; sample input: sieve.in

func sieve(v0)
entry:
  and v1, v0, 127
  add v2, v1, 2
  mov v0, v2
  const v3, 0
  const v4, 2
  jmp for_head1
for_head1:
  lt v5, v4, v0
  br v5, for_body2, for_exit3
for_body2:
  add v6, 512, v4
  load v7, v6
  eq v8, v7, 0
  br v8, then4, endif5
then4:
  add v9, v3, 1
  mov v3, v9
  mul v11, v4, 2
  mov v10, v11
  jmp while_head6
while_head6:
  lt v12, v10, v0
  br v12, while_body7, while_exit8
while_body7:
  add v13, 512, v10
  store v13, 1
  add v14, v10, v4
  mov v10, v14
  jmp while_head6
while_exit8:
  jmp endif5
endif5:
  add v15, v4, 1
  mov v4, v15
  jmp for_head1
for_exit3:
  ret v3
