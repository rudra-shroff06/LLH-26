; name: array_sum
; category: arrays
; description: sum of an array
; sample input: array_sum.in

func array_sum(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  load v5, v3
  add v6, v2, v5
  mov v2, v6
  add v7, v3, 1
  mov v3, v7
  jmp for_head1
for_exit3:
  ret v2
