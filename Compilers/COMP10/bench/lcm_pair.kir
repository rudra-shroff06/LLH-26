; name: lcm_pair
; category: loops
; description: least common multiple using a gcd loop and a division
; sample input: lcm_pair.in

func lcm_pair(v0, v1)
entry:
  const v2, 255
  and v3, v0, v2
  const v4, 1
  add v5, v3, v4
  mov v0, v5
  const v6, 255
  and v7, v1, v6
  const v8, 1
  add v9, v7, v8
  mov v1, v9
  mov v10, v0
  mov v11, v1
  jmp while_head1
while_head1:
  const v12, 0
  eq v14, v11, v12
  const v15, 0
  eq v13, v14, v15
  br v13, while_body2, while_exit3
while_body2:
  mod v17, v10, v11
  mov v16, v17
  mov v10, v11
  mov v11, v16
  jmp while_head1
while_exit3:
  div v18, v0, v10
  mul v19, v18, v1
  ret v19
