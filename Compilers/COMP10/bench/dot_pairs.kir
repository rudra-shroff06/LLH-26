; name: dot_pairs
; category: fused
; description: products of neighbouring pairs, accumulated (multiply-add pattern)
; sample input: dot_pairs.in

func dot_pairs(v0)
entry:
  const v1, 31
  and v2, v0, v1
  mov v0, v2
  const v3, 0
  const v4, 0
  jmp for_head1
for_head1:
  lt v5, v4, v0
  br v5, for_body2, for_exit3
for_body2:
  const v6, 2
  mul v7, v6, v4
  load v8, v7
  const v9, 2
  mul v10, v9, v4
  const v11, 1
  add v12, v10, v11
  load v13, v12
  mul v14, v8, v13
  add v15, v3, v14
  mov v3, v15
  const v16, 1
  add v17, v4, v16
  mov v4, v17
  jmp for_head1
for_exit3:
  ret v3
