; name: digit_sum
; category: loops
; description: sum of decimal digits using div and mod
; sample input: digit_sum.in

func digit_sum(v0)
entry:
  const v1, 0xFFFFFF
  and v2, v0, v1
  mov v0, v2
  const v3, 0
  jmp while_head1
while_head1:
  const v4, 0
  eq v6, v0, v4
  const v7, 0
  eq v5, v6, v7
  br v5, while_body2, while_exit3
while_body2:
  const v8, 10
  mod v9, v0, v8
  add v10, v3, v9
  mov v3, v10
  const v11, 10
  div v12, v0, v11
  mov v0, v12
  jmp while_head1
while_exit3:
  ret v3
