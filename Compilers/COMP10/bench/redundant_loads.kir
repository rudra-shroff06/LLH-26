; name: redundant_loads
; category: junk
; description: the same array element is loaded again and again (no stores in between)
; sample input: redundant_loads.in

func redundant_loads(v0)
entry:
  const v1, 63
  and v2, v0, v1
  mov v0, v2
  const v3, 0
  const v4, 0
  jmp for_head1
for_head1:
  lt v5, v4, v0
  br v5, for_body2, for_exit3
for_body2:
  load v6, v4
  add v7, v3, v6
  load v8, v4
  load v9, v4
  mul v10, v8, v9
  add v11, v7, v10
  load v12, v4
  add v13, v11, v12
  mov v3, v13
  const v14, 1
  add v15, v4, v14
  mov v4, v15
  jmp for_head1
for_exit3:
  ret v3
