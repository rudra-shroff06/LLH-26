; name: merge_sorted
; category: arrays
; description: merge two sorted arrays (at 0 and 16) into addresses 64..
; sample input: merge_sorted.in

func merge_sorted()
entry:
  const v0, 0
  const v1, 0
  const v2, 0
  jmp while_head1
while_head1:
  lt v3, v0, 8
  br v3, while_body2, while_exit3
while_body2:
  lt v4, v1, 8
  br v4, then4, else6
then4:
  load v5, v0
  add v6, 16, v1
  load v7, v6
  lt v9, v7, v5
  eq v8, v9, 0
  br v8, then7, else9
then7:
  load v10, v0
  add v11, 64, v2
  store v11, v10
  add v12, v0, 1
  mov v0, v12
  jmp endif8
else9:
  add v13, 16, v1
  load v14, v13
  add v15, 64, v2
  store v15, v14
  add v16, v1, 1
  mov v1, v16
  jmp endif8
endif8:
  jmp endif5
else6:
  load v17, v0
  add v18, 64, v2
  store v18, v17
  add v19, v0, 1
  mov v0, v19
  jmp endif5
endif5:
  add v20, v2, 1
  mov v2, v20
  jmp while_head1
while_exit3:
  jmp while_head10
while_head10:
  lt v21, v1, 8
  br v21, while_body11, while_exit12
while_body11:
  add v22, 16, v1
  load v23, v22
  add v24, 64, v2
  store v24, v23
  add v25, v1, 1
  mov v1, v25
  add v26, v2, 1
  mov v2, v26
  jmp while_head10
while_exit12:
  ret v2
