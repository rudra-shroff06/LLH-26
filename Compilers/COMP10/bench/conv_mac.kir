; name: conv_mac
; category: fused
; description: 3-tap convolution with coefficients at 64..66
; sample input: conv_mac.in

func conv_mac(v0)
entry:
  and v1, v0, 31
  mov v0, v1
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, v0
  br v3, for_body2, for_exit3
for_body2:
  load v4, v2
  load v5, 64
  mul v6, v4, v5
  add v7, v2, 1
  load v8, v7
  load v9, 65
  mul v10, v8, v9
  add v11, v6, v10
  add v12, v2, 2
  load v13, v12
  load v14, 66
  mul v15, v13, v14
  add v16, v11, v15
  add v17, 100, v2
  store v17, v16
  add v18, v2, 1
  mov v2, v18
  jmp for_head1
for_exit3:
  ret v0
