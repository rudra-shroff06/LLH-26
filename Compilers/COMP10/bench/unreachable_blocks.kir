; name: unreachable_blocks
; category: control
; description: branch on a constant, dead blocks (one would divide by zero) and a block nobody jumps to
; sample input: unreachable_blocks.in

func unreachable_blocks(v0)
entry:
  const v1, 1
  br v1, live, dead1
live:
  mul v2, v0, 3
  add v2, v2, 7
  jmp exit
dead1:
  div v3, v0, 0
  jmp dead2
dead2:
  vstore 1, v3
  trap 5
orphan:
  ret 99
exit:
  ret v2
