; name: sem_signed_cmp
; category: semantics
; description: signed comparisons of raw arguments
; sample input: sem_signed_cmp.in

func sem_signed_cmp(v0, v1)
entry:
  lt v3, v0, v1
  mov v2, v3
  lt v6, v0, v1
  const v7, 0
  eq v5, v6, v7
  mov v4, v5
  const v9, 0
  lt v10, v9, v0
  mov v8, v10
  const v11, 4
  mul v12, v2, v11
  const v13, 2
  mul v14, v4, v13
  add v15, v12, v14
  add v16, v15, v8
  ret v16
