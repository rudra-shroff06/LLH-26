; name: rotate_array
; category: arrays
; description: rotate an array left by one place
; sample input: rotate_array.in

func rotate_array(v0)
entry:
  and v1, v0, 31
  add v2, v1, 1
  mov v0, v2
  load v4, 0
  mov v3, v4
  const v5, 0
  jmp for_head1
for_head1:
  sub v6, v0, 1
  lt v7, v5, v6
  br v7, for_body2, for_exit3
for_body2:
  add v8, v5, 1
  load v9, v8
  store v5, v9
  add v10, v5, 1
  mov v5, v10
  jmp for_head1
for_exit3:
  sub v11, v0, 1
  store v11, v3
  ret v0
