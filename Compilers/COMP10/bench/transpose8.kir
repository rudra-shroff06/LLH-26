; name: transpose8
; category: arrays
; description: 8x8 transpose (input at 0, output at 128)
; sample input: transpose8.in

func transpose8()
entry:
  const v0, 0
  jmp for_head1
for_head1:
  const v1, 8
  lt v2, v0, v1
  br v2, for_body2, for_exit3
for_body2:
  const v3, 0
  jmp for_head4
for_head4:
  const v4, 8
  lt v5, v3, v4
  br v5, for_body5, for_exit6
for_body5:
  const v6, 8
  mul v7, v0, v6
  add v8, v7, v3
  load v9, v8
  const v10, 128
  const v11, 8
  mul v12, v3, v11
  add v13, v10, v12
  add v14, v13, v0
  store v14, v9
  const v15, 1
  add v16, v3, v15
  mov v3, v16
  jmp for_head4
for_exit6:
  const v17, 1
  add v18, v0, v17
  mov v0, v18
  jmp for_head1
for_exit3:
  const v19, 0
  ret v19
