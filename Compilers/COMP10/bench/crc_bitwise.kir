; name: crc_bitwise
; category: bits
; description: bitwise CRC-32 of the low bytes of an array
; sample input: crc_bitwise.in

func crc_bitwise(v0)
entry:
  and v1, v0, 15
  mov v0, v1
  const v2, 0xFFFFFFFF
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  load v5, v3
  and v6, v5, 255
  xor v7, v2, v6
  mov v2, v7
  const v8, 0
  jmp for_head4
for_head4:
  lt v9, v8, 8
  br v9, for_body5, for_exit6
for_body5:
  and v10, v2, 1
  eq v11, v10, 1
  br v11, then7, else9
then7:
  shr v12, v2, 1
  xor v13, v12, 0xEDB88320
  mov v2, v13
  jmp endif8
else9:
  shr v14, v2, 1
  mov v2, v14
  jmp endif8
endif8:
  add v15, v8, 1
  mov v8, v15
  jmp for_head4
for_exit6:
  add v16, v3, 1
  mov v3, v16
  jmp for_head1
for_exit3:
  xor v17, v2, 0xFFFFFFFF
  ret v17
