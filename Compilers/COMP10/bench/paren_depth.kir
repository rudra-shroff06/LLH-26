; name: paren_depth
; category: state
; description: bracket depth: 0 opens, 1 closes; reports max depth and an error flag
; sample input: paren_depth.in

func paren_depth(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0
  const v3, 0
  const v4, 0
  const v5, 0
  jmp for_head1
for_head1:
  lt v6, v5, v0
  br v6, for_body2, for_exit3
for_body2:
  load v8, v5
  and v9, v8, 3
  mov v7, v9
  eq v10, v7, 0
  br v10, then4, else6
then4:
  add v11, v2, 1
  mov v2, v11
  lt v12, v3, v2
  br v12, then7, endif8
then7:
  mov v3, v2
  jmp endif8
endif8:
  jmp endif5
else6:
  eq v13, v7, 1
  br v13, then9, endif10
then9:
  eq v14, v2, 0
  br v14, then11, else13
then11:
  const v4, 1
  jmp endif12
else13:
  sub v15, v2, 1
  mov v2, v15
  jmp endif12
endif12:
  jmp endif10
endif10:
  jmp endif5
endif5:
  add v16, v5, 1
  mov v5, v16
  jmp for_head1
for_exit3:
  mul v17, v3, 4
  add v18, v17, v4
  ret v18
