; name: swap_via_memory
; category: effects
; description: swap two memory words, then read both again (loads after stores)
; sample input: swap_via_memory.in

func swap_via_memory(v0, v1)
entry:
  and v3, v0, 15
  load v4, v3
  mov v2, v4
  and v5, v1, 15
  load v6, v5
  and v7, v0, 15
  store v7, v6
  and v8, v1, 15
  store v8, v2
  and v9, v0, 15
  load v10, v9
  mul v11, v10, 7
  and v12, v1, 15
  load v13, v12
  add v14, v11, v13
  ret v14
