; name: stencil3
; category: arrays
; description: 3-point stencil written to addresses 101..
; sample input: stencil3.in

func stencil3(v0)
entry:
  and v1, v0, 31
  add v2, v1, 3
  mov v0, v2
  const v3, 1
  jmp for_head1
for_head1:
  sub v4, v0, 1
  lt v5, v3, v4
  br v5, for_body2, for_exit3
for_body2:
  sub v6, v3, 1
  load v7, v6
  load v8, v3
  mul v9, 2, v8
  add v10, v7, v9
  add v11, v3, 1
  load v12, v11
  add v13, v10, v12
  add v14, 100, v3
  store v14, v13
  add v15, v3, 1
  mov v3, v15
  jmp for_head1
for_exit3:
  ret v0
