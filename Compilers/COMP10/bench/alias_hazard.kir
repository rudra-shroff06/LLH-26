; name: alias_hazard
; category: arrays
; description: a store and a later load may use the same address (when a and b match)
; sample input: alias_hazard.in

func alias_hazard(v0, v1, v2)
entry:
  and v4, v1, 63
  load v5, v4
  mov v3, v5
  add v6, v3, v0
  and v7, v2, 63
  store v7, v6
  and v9, v1, 63
  load v10, v9
  mov v8, v10
  mul v11, v3, 3
  add v12, v11, v8
  ret v12
