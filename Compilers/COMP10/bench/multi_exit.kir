; name: multi_exit
; category: control
; description: a loop with three different ways out, each returning something different
; sample input: multi_exit.in

func multi_exit(v0)
entry:
  and v1, v0, 63
  const v2, 0
  const v3, 1
  jmp head
head:
  lt v4, v2, v1
  br v4, body, exit_a
body:
  mul v3, v3, 3
  add v3, v3, v2
  eq v5, v3, 100
  br v5, exit_b, check
check:
  and v6, v3, 1023
  eq v7, v6, 77
  br v7, exit_c, next
next:
  add v2, v2, 1
  jmp head
exit_a:
  ret v3
exit_b:
  add v3, v3, 1000
  ret v3
exit_c:
  sub v3, v3, 1
  ret v3
