; name: collatz
; category: loops
; description: Collatz step count
; sample input: collatz.in

func collatz(v0)
entry:
  const v1, 1023
  and v2, v0, v1
  const v3, 1
  add v4, v2, v3
  mov v0, v4
  const v5, 0
  jmp while_head1
while_head1:
  const v6, 1
  eq v8, v0, v6
  const v9, 0
  eq v7, v8, v9
  br v7, while_body2, while_exit3
while_body2:
  const v10, 1
  and v11, v0, v10
  const v12, 1
  eq v13, v11, v12
  br v13, then4, else6
then4:
  const v14, 3
  mul v15, v14, v0
  const v16, 1
  add v17, v15, v16
  mov v0, v17
  jmp endif5
else6:
  const v18, 1
  shr v19, v0, v18
  mov v0, v19
  jmp endif5
endif5:
  const v20, 1
  add v21, v5, v20
  mov v5, v21
  jmp while_head1
while_exit3:
  ret v5
