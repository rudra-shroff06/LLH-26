; name: matvec8
; category: arrays
; description: 8-wide matrix-vector product (A at 0, x at 64, y at 72)
; sample input: matvec8.in

func matvec8(v0)
entry:
  and v2, v0, 7
  add v3, v2, 1
  mov v1, v3
  const v4, 0
  jmp for_head1
for_head1:
  lt v5, v4, v1
  br v5, for_body2, for_exit3
for_body2:
  const v6, 0
  const v7, 0
  jmp for_head4
for_head4:
  lt v8, v7, 8
  br v8, for_body5, for_exit6
for_body5:
  mul v9, v4, 8
  add v10, v9, v7
  load v11, v10
  add v12, 64, v7
  load v13, v12
  mul v14, v11, v13
  add v15, v6, v14
  mov v6, v15
  add v16, v7, 1
  mov v7, v16
  jmp for_head4
for_exit6:
  add v17, 72, v4
  store v17, v6
  add v18, v4, 1
  mov v4, v18
  jmp for_head1
for_exit3:
  ret v1
