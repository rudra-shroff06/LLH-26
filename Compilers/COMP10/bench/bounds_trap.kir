; name: bounds_trap
; category: effects
; description: stores a running sum, then traps when the index reaches 64
; sample input: bounds_trap.in

func bounds_trap(v0)
entry:
  and v1, v0, 255
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  lt v6, v3, 64
  eq v5, v6, 0
  br v5, then4, endif5
then4:
  trap 7
endif5:
  add v7, 300, v3
  store v7, v2
  load v8, v3
  add v9, v2, v8
  mov v2, v9
  add v10, v3, 1
  mov v3, v10
  jmp for_head1
for_exit3:
  ret v2
