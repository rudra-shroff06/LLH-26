; name: insertion_sort
; category: arrays
; description: insertion sort (signed)
; sample input: insertion_sort.in

func insertion_sort(v0)
entry:
  and v1, v0, 15
  mov v0, v1
  const v2, 1
  jmp for_head1
for_head1:
  lt v3, v2, v0
  br v3, for_body2, for_exit3
for_body2:
  load v5, v2
  mov v4, v5
