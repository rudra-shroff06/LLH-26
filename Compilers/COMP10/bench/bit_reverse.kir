; name: bit_reverse
; category: bits
; description: reverse the bits of a word one at a time
; sample input: bit_reverse.in

func bit_reverse(v0)
entry:
  const v1, 0
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, 32
  br v3, for_body2, for_exit3
for_body2:
  shr v5, v0, v2
  and v6, v5, 1
  mov v4, v6
  sub v7, 31, v2
  shl v8, v4, v7
  or v9, v1, v8
  mov v1, v9
  add v10, v2, 1
  mov v2, v10
  jmp for_head1
for_exit3:
  ret v1
