; name: pow_fast
; category: numbers
; description: fast modular exponentiation with a while loop (modulus 46337)
; sample input: pow_fast.in

func pow_fast(v0, v1)
entry:
  const v2, 1023
  and v3, v0, v2
  const v4, 2
  add v5, v3, v4
  mov v0, v5
  const v6, 255
  and v7, v1, v6
  mov v1, v7
  const v8, 1
  jmp while_head1
while_head1:
  const v9, 0
  eq v11, v1, v9
  const v12, 0
  eq v10, v11, v12
  br v10, while_body2, while_exit3
while_body2:
  const v13, 1
  and v14, v1, v13
  const v15, 1
  eq v16, v14, v15
  br v16, then4, endif5
then4:
  mul v17, v8, v0
  const v18, 46337
  mod v19, v17, v18
  mov v8, v19
  jmp endif5
endif5:
  mul v20, v0, v0
  const v21, 46337
  mod v22, v20, v21
  mov v0, v22
  const v23, 1
  shr v24, v1, v23
  mov v1, v24
  jmp while_head1
while_exit3:
  ret v8
