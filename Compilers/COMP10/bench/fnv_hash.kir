; name: fnv_hash
; category: bits
; description: FNV-style hash of the low bytes of an array
; sample input: fnv_hash.in

func fnv_hash(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0x811C9DC5
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  load v5, v3
  and v6, v5, 255
  xor v7, v2, v6
  mul v8, v7, 0x1000193
  mov v2, v8
  add v9, v3, 1
  mov v3, v9
  jmp for_head1
for_exit3:
  ret v2
