; name: sem_shifts
; category: semantics
; description: shifts with raw amounts: only the low 5 bits of the amount count
; sample input: sem_shifts.in

func sem_shifts(v0, v1)
entry:
  shl v2, v0, v1
  shr v3, v0, v1
  add v4, v2, v3
  add v5, v1, 33
  shl v6, v0, v5
  add v7, v1, 31
  shr v8, v0, v7
  xor v9, v6, v8
  add v10, v4, v9
  ret v10
