; name: constant_branch
; category: junk
; description: a branch whose condition is a known constant
; sample input: constant_branch.in

func constant_branch(v0)
entry:
  const v1, 63
  and v2, v0, v1
  mov v0, v2
  const v3, 8
  const v4, 0
  const v5, 0
  jmp for_head1
for_head1:
  lt v6, v5, v0
  br v6, for_body2, for_exit3
for_body2:
  const v7, 4
  lt v8, v7, v3
  br v8, then4, else6
then4:
  add v9, v4, v5
  mov v4, v9
  jmp endif5
else6:
  const v10, 7
  mul v11, v5, v10
  sub v12, v4, v11
  mov v4, v12
  jmp endif5
endif5:
  const v13, 1
  add v14, v5, v13
  mov v5, v14
  jmp for_head1
for_exit3:
  ret v4
