; name: strength_ladder
; category: junk
; description: multiplications, divisions and modulos by constants of a loop counter
; sample input: strength_ladder.in

func strength_ladder(v0)
entry:
  const v1, 63
  and v2, v0, v1
  mov v0, v2
  const v3, 0
  const v4, 0
  jmp for_head1
for_head1:
  lt v5, v4, v0
  br v5, for_body2, for_exit3
for_body2:
  const v6, 8
  mul v7, v4, v6
  add v8, v3, v7
  const v9, 10
  mul v10, v4, v9
  add v11, v8, v10
  const v12, 3
  mul v13, v4, v12
  add v14, v11, v13
  mov v3, v14
  const v15, 16
  mul v16, v4, v15
  add v17, v3, v16
  mov v3, v17
  const v18, 4
  div v19, v4, v18
  add v20, v3, v19
  const v21, 8
  mod v22, v4, v21
  add v23, v20, v22
  mov v3, v23
  const v24, 1
  add v25, v4, v24
  mov v4, v25
  jmp for_head1
for_exit3:
  ret v3
