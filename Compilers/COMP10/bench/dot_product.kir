; name: dot_product
; category: arrays
; description: dot product of two vectors at addresses 0 and 32
; sample input: dot_product.in

func dot_product(v0)
entry:
  and v1, v0, 31
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  load v5, v3
  add v6, 32, v3
  load v7, v6
  mul v8, v5, v7
  add v9, v2, v8
  mov v2, v9
  add v10, v3, 1
  mov v3, v10
  jmp for_head1
for_exit3:
  ret v2
