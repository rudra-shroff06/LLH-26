; name: vec_add
; category: arrays
; description: vector add into addresses 64..
; sample input: vec_add.in

func vec_add(v0)
entry:
  and v1, v0, 31
  mov v0, v1
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, v0
  br v3, for_body2, for_exit3
for_body2:
  load v4, v2
  add v5, 32, v2
  load v6, v5
  add v7, v4, v6
  add v8, 64, v2
  store v8, v7
  add v9, v2, 1
  mov v2, v9
  jmp for_head1
for_exit3:
  ret v0
