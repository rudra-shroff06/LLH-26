endif5:
  and v9, v5, 1
  eq v10, v9, 1
  br v10, then7, else9
then7:
  add v12, v8, 1
  mov v11, v12
  jmp endif8
else9:
  sub v13, v8, 1
  mov v11, v13
  jmp endif8
endif8:
  add v14, v2, v11
  mov v2, v14
  add v15, v3, 1
  mov v3, v15
