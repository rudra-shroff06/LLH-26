; name: branchy_select
; category: junk
; description: branches that could be selects
; sample input: branchy_select.in

func branchy_select(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  load v6, v3
  mov v5, v6
  lt v7, 100, v5
  br v7, then4, else6
then4:
  mov v8, v5
  jmp endif5
else6:
