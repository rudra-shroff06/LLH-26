; name: rotate_mix
; category: bits
; description: rotate-add-xor mixing rounds
; sample input: rotate_mix.in

func rotate_mix(v0, v1)
entry:
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, 8
  br v3, for_body2, for_exit3
for_body2:
  shl v4, v0, 5
  shr v5, v0, 27
  or v6, v4, v5
  add v7, v6, v1
  mov v0, v7
  shl v8, v1, 3
  shr v9, v1, 29
  or v10, v8, v9
  xor v11, v10, v0
  mov v1, v11
  add v12, v2, 1
  mov v2, v12
  jmp for_head1
for_exit3:
  xor v13, v0, v1
  ret v13
