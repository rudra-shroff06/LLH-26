; name: vlog_every_other
; category: effects
; description: logs every other square to a volatile port
; sample input: vlog_every_other.in

func vlog_every_other(v0)
entry:
  and v1, v0, 15
  mov v0, v1
  const v2, 0
  jmp for_head1
for_head1:
  lt v3, v2, v0
  br v3, for_body2, for_exit3
for_body2:
  mul v5, v2, v2
  mov v4, v5
  and v6, v2, 1
  eq v7, v6, 0
  br v7, then4, endif5
then4:
  vstore 0, v4
  jmp endif5
endif5:
  add v8, v2, 1
  mov v2, v8
  jmp for_head1
for_exit3:
  ret v0
