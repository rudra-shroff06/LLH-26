; name: vending_fsm
; category: state
; description: vending machine automaton with nested if/elif on state and event
; sample input: vending_fsm.in

func vending_fsm(v0)
entry:
  and v1, v0, 31
  mov v0, v1
  const v2, 0
  const v3, 0
  const v4, 0
  const v5, 0
  jmp for_head1
