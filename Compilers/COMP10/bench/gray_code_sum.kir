; name: gray_code_sum
; category: bits
; description: sum of Gray codes
; sample input: gray_code_sum.in

func gray_code_sum(v0)
entry:
  and v1, v0, 63
  mov v0, v1
  const v2, 0
  const v3, 0
  jmp for_head1
for_head1:
  lt v4, v3, v0
  br v4, for_body2, for_exit3
for_body2:
  shr v6, v3, 1
  xor v7, v3, v6
  mov v5, v7
  add v8, v2, v5
  mov v2, v8
  add v9, v3, 1
  mov v3, v9
  jmp for_head1
for_exit3:
  ret v2
