; name: partial_redundancy
; category: junk
; description: an expression that is computed on one path and again after the join
; sample input: partial_redundancy.in

func partial_redundancy(v0, v1)
entry:
  const v2, 1
  and v3, v0, v2
  const v4, 1
  eq v5, v3, v4
  br v5, then1, else3
then1:
  const v7, 7
  mul v8, v1, v7
  const v9, 3
  add v10, v8, v9
  mov v6, v10
  jmp endif2
else3:
  const v6, 0
  jmp endif2
endif2:
  const v12, 7
  mul v13, v1, v12
  const v14, 3
  add v15, v13, v14
  mov v11, v15
  add v16, v6, v11
  ret v16
